{
  "name": "@handset/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "pnpm db:migrate",
    "migration:revert": "pnpm db:revert",
    "migration:show": "pnpm db:status",
    "db:migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "db:migration:create": "typeorm-ts-node-commonjs migration:create",
    "db:migrate": "ts-node src/database/cli.ts migrate",
    "db:revert": "ts-node src/database/cli.ts revert",
    "db:seed": "ts-node src/database/seed/cli.ts",
    "db:status": "ts-node src/database/cli.ts status",
    "db:seed:demo:clear": "ts-node src/database/seed/cli.ts --clear-demo",
    "inventory:reconcile": "ts-node src/inventory/reconcile.cli.ts"
  },
  "dependencies": {
    "@handset/shared": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.1",
    "cookie-parser": "~1.4.7",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "mssql": "^12.2.0",
    "nestjs-pino": "^4.5.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "~1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2"
  }
}
