NODE_ENV=development
PORT=3001

# Required. Use a least-privilege runtime SQL login. Never commit actual credentials.
# Percent-encode URL usernames/passwords, e.g. @ -> %40, # -> %23, % -> %25.
DATABASE_URL=mssql://app_user:replace_me@localhost:1433/handset_portal?encrypt=true&trustServerCertificate=false
# Alternative (quote the full dotenv value; double quotes inside delimit ADO values):
# DATABASE_URL='Server=localhost,1433;Database=handset_portal;User Id=app_user;Password="p;ass";Encrypt=true;TrustServerCertificate=false'
# Optional higher-privilege login used ONLY by explicit migration commands.
# Omit when unused (an empty value is invalid).
# DATABASE_MIGRATION_URL=mssql://migration_user:replace_me@localhost:1433/handset_portal?encrypt=true&trustServerCertificate=false
DB_POOL_MAX=10
# milliseconds
DB_CONNECT_TIMEOUT=15000

# Validated now; session implementation is a future module.
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
# API_URL belongs in apps/web/.env.local; it is not an API setting.

# Module 1: applies to all tables and the migration ledger.
DB_SCHEMA=dbo
# Separate test database with schema creation rights; omitted means integration tests skip.
# TEST_DATABASE_URL=mssql://test_user:replace_me@localhost:1433/handset_portal_test?encrypt=true&trustServerCertificate=false
# Set ALL three to create the initial administrator; never commit actual values.
# SEED_ADMIN_USERNAME=initial_admin
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters
SEED_DEMO_DATA=false
# Module 2: required secret (minimum 32 characters); generate locally, never commit it.
CSRF_SECRET=
ALLOWED_ORIGINS=http://localhost:3000
# Unprefixed name; production uses __Host- plus this name.
SESSION_COOKIE_NAME=sid
SESSION_TOUCH_INTERVAL_SECONDS=60
# Set only to match the trusted proxy chain. false is safe for direct/local API access.
TRUST_PROXY=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
LOGIN_RATE_WINDOW_SECONDS=60
LOGIN_IP_LIMIT=60
LOGIN_USERNAME_LIMIT=20
SESSION_RETENTION_DAYS=7
LOGIN_ATTEMPT_RETENTION_DAYS=90
# Inventory and sales (PKR list prices are informational)
LOW_STOCK_THRESHOLD=3
SALES_BACKDATE_MAX_DAYS=3
SALE_SELF_VOID_MINUTES=10
