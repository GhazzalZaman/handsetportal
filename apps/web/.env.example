# Server-only upstream origin; never use a NEXT_PUBLIC_ variable for this.
API_URL=http://localhost:3001
# DATABASE_URL, DATABASE_MIGRATION_URL and session timeout settings are API-only.
# Configure them in apps/api/.env, never in browser-accessible environment values.

# Must match the API's unprefixed cookie name; never copy CSRF_SECRET here.
SESSION_COOKIE_NAME=sid
